#!/bin/bash

log_info() {
  printf "\n\e[0;35m $1\e[0m\n\n"
}

log_warn() {
  printf "\e[0;33m $1\e[0m\n"
}

build() {
    purify
    log_info "Building images locally"
    # Force classic sequential builds: Compose Bake builds services as isolated
    # buildx targets and won't see the locally-built hpcts-local-base:latest image
    # before htcondor/ondemand need it as their FROM base, causing Docker to try
    # (and fail) to pull it from Docker Hub instead.
    COMPOSE_BAKE=false docker compose build --no-cache
}

start() {
    log_info "Fetching latest HPC Toolset Images.."
    docker compose pull

    log_info "Starting HPC Toolset Cluster.."
    docker compose up -d --remove-orphans

    log_info "OnDemand URL: https://localhost:3443"
    log_info "Login to htc.mini: ssh -p 7222 hpcadmin@localhost"
}

stop() {
    log_info "Stopping HPC Toolset Cluster containers.."
    docker compose stop
}

destroy() {
    log_info "Stopping and removing HPC Toolset Cluster containers and volumes.."
    docker compose stop && \
    docker compose rm -f -v && \
    docker compose down -v
}

cleanup() {
    log_warn "** WARNING: This will remove all container images and you'll need to re-download **"
    log_warn "You probably want to try running the 'destroy' command first."
    echo ""
    read -p "Do you want to proceed? (yes/no) " yn

    if [[ $yn == y* ]]; then
        purify
    else
        log_info "cleanup cancelled. existing.."
    fi
}

purify() {
    log_info "Removing HPC Toolset containers and images.."
    destroy
    docker rmi -f $(docker images | grep ood-htc | awk '{print $1}') 2> /dev/null
    docker rmi -f $(docker images | grep hpcts-local-base | awk '{print $1}') 2> /dev/null
}

case "$1" in
    'start')
        start
        ;;
    'stop')
        stop
        ;;
    'cleanup')
        cleanup
        ;;
    'build')
        build
        ;;
    'destroy')
        destroy
        ;;
    *)
        log_info "Usage: $0 { build | start | stop | destroy | cleanup}"
        exit 1
        ;;
esac
